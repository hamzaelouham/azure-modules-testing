# Copy to terraform.tfvars and adjust. terraform.tfvars is git-ignored.

# subscription_id = "00000000-0000-0000-0000-000000000000" # or export ARM_SUBSCRIPTION_ID

resource_group_name = "k8s-cluster"
location            = "eastus2"

# Must not overlap the peer VNet when peering_enabled = true.
vnet_address_space      = ["10.1.0.0/16"]
subnet_address_prefixes = ["10.1.1.0/24"]

# Optional peering with an existing VNet (it must already exist).
peering_enabled = false
# peer_vnet_name           = "devopsVM-vnet"
# peer_vnet_resource_group = "devops-group"

# "*" (default) opens SSH to any source; use a CIDR to restrict it, or null to
# use the peer VNet's range (needs peering_enabled = true).
allowed_ssh_source       = "*"
master_public_ip_enabled = true

admin_username       = "k8sadmin"
ssh_public_key_path  = "~/.ssh/id_rsa.pub"
ssh_private_key_path = "~/.ssh/id_rsa"

master_vm_name        = "k8s-master"
master_vm_size        = "Standard_D2ls_v7"
worker_count          = 1 # Free Trial: 4 vCPUs per region
worker_vm_name_prefix = "k8s-worker"
worker_vm_size        = "Standard_D2ls_v7"

k8s_version = "1.35"

kv_sku_name                   = "standard"
kv_purge_protection_enabled   = false
kv_soft_delete_retention_days = 7

tags = {
  Environment = "Development"
  ManagedBy   = "Terraform"
  Project     = "Kubernetes"
}
