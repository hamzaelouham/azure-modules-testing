# Hosts are named by private IP; Ansible connects to the master via its public IP
# and to the workers by jumping through the master.
[master]
${master_ip} ansible_host=${master_public_ip} ansible_user=${ssh_user} ansible_ssh_private_key_file=${ssh_private_key_path} ansible_become=true

[worker]
%{ for ip in worker_ips ~}
${ip} ansible_user=${ssh_user} ansible_ssh_private_key_file=${ssh_private_key_path} ansible_become=true
%{ endfor ~}

[worker:vars]
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o ProxyCommand="ssh -W %h:%p -o StrictHostKeyChecking=no -i ${ssh_private_key_path} ${ssh_user}@${master_public_ip}"'

[all:children]
master
worker

[all:vars]
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
